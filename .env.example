# Copie este archivo como .env y pegue la cadena "Session pooler" de Supabase.
# Debe usar el puerto 5432 y la contraseña codificada para URL.
# postgresql://postgres.hxgewarawsnhttcxpnhw:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_SCHEMA=aza
# Active SQLite local con DEBUG=1 solo para desarrollo aislado.
# AZA_SQLITE_LOCAL=1
# API_TOKEN_CAPTURA=
# SECRET_KEY=
# DEBUG=1
# ALLOWED_HOSTS=
# PUBLIC_BASE_URL=

# Si usa DEBUG=0, configure un servicio SMTP autenticado con STARTTLS.
# En Render Free, use un proveedor que admita un puerto habilitado como el 2525.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
